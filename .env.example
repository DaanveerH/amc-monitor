# Key reference only. Store real values in a local environment or secret manager.
AMC_DATABASE_URL=postgresql+psycopg://ROLE:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
AMC_DATABASE_CA_CERT=replace-with-database-ca-certificate
LOG_LEVEL=INFO

# Worker only
AMC_HTTPS_PROXY=http://USERNAME:PASSWORD@PROXY_HOST:PORT
AMC_HTTPS_PROXY_FAILOVER=[]
AMC_WORKER_IDLE_SECONDS=1

# Discord bot only
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_ALLOWED_GUILD_IDS=111111111111111111
DISCORD_BOOTSTRAP_USER_IDS=
DISCORD_SUPER_USER_IDS=
DISCORD_TEST_GUILD_ID=111111111111111111
DISCORD_OUTBOX_POLL_SECONDS=2
DISCORD_OUTBOX_BATCH_SIZE=10
DISCORD_HEARTBEAT_SECONDS=30

# Owner notifier only
OWNER_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/replace-with-webhook-token
OWNER_NOTIFIER_LEDGER_PATH=./data/incidents.sqlite3
OWNER_HEARTBEAT_SERVICES=amc-worker,amc-discord-bot
OWNER_CHECK_INTERVAL_SECONDS=30
OWNER_HEARTBEAT_STALE_SECONDS=180
OWNER_REMINDER_HOURS=6
OWNER_DELIVERY_HOURLY_CAP=10
